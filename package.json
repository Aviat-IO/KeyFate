{
  "name": "dead-mans-switch-infrastructure",
  "version": "1.0.0",
  "description": "Local development infrastructure for Dead Man's Switch",
  "private": true,
  "scripts": {
    "install-dev": "make install",
    "dev": "make dev",
    "test": "cd frontend && bun test",
    "test:postgres": "cd frontend && bun run test:postgres",
    "migrate": "bun run scripts/migrate.js",
    "seed": "bun run scripts/seed-local-db.js",
    "test-db": "bun run scripts/test-db-connection.js",
    "reset-db": "make reset-db"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "."
  },
  "author": "Dead Man's Switch Development Team",
  "license": "MIT"
}
